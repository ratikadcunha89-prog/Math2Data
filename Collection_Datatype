# 🌱 1. LIST
# A List is ordered and MUTABLE.

fruits_list = [
    "Starfruit",
    "Cacao",
    "Canistel",
    "Mangosteen",
    "Avocado",
    "Grapefruit",
    "Papaya",
    "Coconut"
]

print("\n🌱 1. LIST")
print("My fruits:", fruits_list)

print("\nA List is MUTABLE.")
print("Mutable means it can be changed.")

fruits_list.append("Banana")

print("After adding Banana:")
print(fruits_list)


# 📚 2. TUPLE
# A Tuple is ordered and IMMUTABLE.

learning = (
    "Python",
    "SQL",
    "Excel",
    "Statistics"
)

print("\n📚 2. TUPLE")
print("What I am learning:", learning)

print("\nA Tuple is IMMUTABLE.")
print("Immutable means it cannot be changed after creation.")


# 🌿 3. SET
# A Set stores unique values.

unique_fruits = {
    "Starfruit",
    "Cacao",
    "Canistel",
    "Mangosteen",
    "Avocado",
    "Grapefruit",
    "Papaya",
    "Coconut"
}

print("\n🌿 3. SET")
print("Unique fruits in my garden:", unique_fruits)

print("\nA Set stores UNIQUE values.")
print("It does not keep duplicate values.")


# 📊 4. DICTIONARY
# A Dictionary stores data as key-value pairs.

plant_details = {
    "name": "Coconut",
    "type": "Tree",
    "fruit": "Coconut",
    "use": "Food"
}

print("\n📊 4. DICTIONARY")
print("Plant details:", plant_details)

print("\nA Dictionary stores data as:")
print("KEY → VALUE")


